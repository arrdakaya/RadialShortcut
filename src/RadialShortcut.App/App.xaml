<Application x:Class="RadialShortcut.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="RadialShortcut"
                        MenuActivation="RightClick"
                        NoLeftClickDelay="True"
                        TrayLeftMouseUp="OnTrayLeftClick">
            <tb:TaskbarIcon.IconSource>
                <BitmapImage UriSource="pack://application:,,,/Assets/app.ico" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="UpdateItem" Header="Güncelle" Visibility="Collapsed" Click="OnUpdateClick" />
                    <MenuItem x:Name="LibraryItem" Header="Kütüphane" Click="OnLibraryClick" />
                    <MenuItem x:Name="PauseItem" Header="Duraklat" IsCheckable="True" Click="OnPauseClick" />
                    <MenuItem x:Name="DebugItem" Header="Debug paneli" IsCheckable="True" IsChecked="False" Click="OnDebugClick" />
                    <MenuItem x:Name="SettingsItem" Header="Ayarlar…" Click="OnSettingsClick" />
                    <MenuItem x:Name="CheckUpdateItem" Header="Güncellemeleri denetle" Click="OnCheckUpdateClick" />
                    <Separator />
                    <MenuItem x:Name="ExitItem" Header="Çıkış" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
