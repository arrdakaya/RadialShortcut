<Application x:Class="RadialShortcut.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="RadialShortcut"
                        MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="R" Foreground="White" Background="#0067C0" FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="PauseItem" Header="Duraklat" IsCheckable="True" Click="OnPauseClick" />
                    <MenuItem x:Name="DebugItem" Header="Debug paneli" IsCheckable="True" IsChecked="True" Click="OnDebugClick" />
                    <MenuItem x:Name="StartupItem" Header="Windows ile başlat" IsCheckable="True" Click="OnStartupClick" />
                    <MenuItem Header="Ayar klasörünü aç" Click="OnOpenConfigFolderClick" />
                    <Separator />
                    <MenuItem Header="Çıkış" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
