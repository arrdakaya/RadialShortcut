<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RadialShortcut.Core\RadialShortcut.Core.csproj" />
    <ProjectReference Include="..\RadialShortcut.Input\RadialShortcut.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="RadialShortcut.Core.Loc" Static="true" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RadialShortcut</AssemblyName>
    <Version>0.9.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- A tray app that idles almost all day: no background GC thread, and hand memory back eagerly. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Only takes effect with dotnet publish -r: precompiled code, so tools open without JIT pauses. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Drops the framework's translated error messages for a dozen languages. -->
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WinRT projection is huge and only used by a few tools; precompiling it doubles it. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <EmbeddedResource Include="config.example.json" LogicalName="RadialShortcut.App.config.example.json" />
  </ItemGroup>

</Project>
