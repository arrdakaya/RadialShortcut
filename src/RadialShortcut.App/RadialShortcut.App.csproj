<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RadialShortcut.Core\RadialShortcut.Core.csproj" />
    <ProjectReference Include="..\RadialShortcut.Input\RadialShortcut.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RadialShortcut</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- A tray app that idles almost all day: no background GC thread, and hand memory back eagerly. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Only takes effect with dotnet publish -r: precompiled code, so tools open without JIT pauses. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.example.json" LogicalName="RadialShortcut.App.config.example.json" />
  </ItemGroup>

</Project>
