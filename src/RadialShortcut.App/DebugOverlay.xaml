<Window x:Class="RadialShortcut.App.DebugOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadialShortcut debug"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize">
    <Border Background="#E61C1C1C" CornerRadius="8" Padding="14">
        <StackPanel>
            <TextBlock Text="RadialShortcut · debug" Foreground="#A8A8A8" FontSize="11" />
            <TextBlock x:Name="PhaseText" Text="Idle" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" />
            <TextBlock x:Name="RingText" Text="—" Foreground="#4CC2FF" FontSize="13" Margin="0,2,0,8" />
            <ItemsControl x:Name="LogList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#D0D0D0" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
